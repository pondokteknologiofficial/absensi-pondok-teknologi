# ===================================================
# KONFIGURASI SUPABASE POSTGRESQL & ENVIRONMENT
# Absensi Pondok Teknologi
# ===================================================

# Port Server Express (Default: 3000)
PORT=3000

# Connection string PostgreSQL dari Supabase (Wajib untuk mode Online / Supabase)
# Dapatkan dari: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# Contoh (Transaction Pooler - Port 6543):
# DATABASE_URL=postgres://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
# Atau Direct Connection (Port 5432):
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL=

# Supabase Project URL & Publishable / Anon Key (Opsional untuk integrasi client atau metadata)
# Dapatkan dari: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
